[alias]
	rebuild = "!f() { ROOT=\"$(git rev-parse --show-toplevel)\"; cd \"$ROOT/source/samplelib-indexer\" && cargo build --release && cp target/release/index_to_manifest \"$ROOT/index_to_manifest\"; }; f"

	libadd = "!f() { \
		if [ $# -eq 0 ]; then \
			echo \"Usage: git libadd \\\"commit message\\\"\"; \
			exit 1; \
		fi; \
		ROOT=$(git rev-parse --show-toplevel); \
		\"$ROOT/index_to_manifest\"; \
		git add manifest.yaml; \
		if git diff --cached --quiet; then \
			echo \"No changes to commit.\"; \
			exit 0; \
		fi; \
		git commit -m \"$1\"; \
	}; f"